{
    "server": {
        "host": "0.0.0.0",
        "port": 5555,
        "data_dir": "./data",
        "server_id": 1
    },
    "tls": {
        "enabled": false,
        "cert_file": "server.crt",
        "key_file": "server.key"
    },
    "logging": {
        "level": "INFO",
        "file": "kosdb.log"
    },
    "performance": {
        "cache_size": 8388608,
        "write_buffer_size": 4194304,
        "max_open_files": 1000,
        "bloom_filter_bits": 10,
        "compression": "snappy"
    }
}
